#!/usr/bin/env python3
"""Wait for initialized shell readiness; bound startup, preserve healthy logouts."""
import os
from pathlib import Path
import signal
import stat
import subprocess
import sys
import tempfile
import time


def stop_group(child):
    # Only our own freshly created process group; never inherited session processes.
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(child.pid, sig)
        except ProcessLookupError:
            break
        if sig == signal.SIGTERM:
            time.sleep(0.2)
    child.wait()


def acknowledged(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as file:
            info = os.fstat(file.fileno())
            return (stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid()
                    and stat.S_IMODE(info.st_mode) == 0o600
                    and file.read(7) == b"ready\n")
    except OSError:
        return False


def run(command, timeout=15.0):
    # New directory on every attempt prevents stale previous-session readiness.
    # It is private even if the caller has a permissive umask.
    with tempfile.TemporaryDirectory(prefix="des-ui-startup-") as directory:
        ready = Path(directory) / "ready"
        env = dict(os.environ, DES_UI_SESSION_READY=str(ready))
        child = subprocess.Popen(command, env=env, start_new_session=True)
        deadline = time.monotonic() + timeout
        try:
            while True:
                status = child.poll()
                if status is not None:
                    if status != 0:
                        stop_group(child)
                    return status if status >= 0 else 128 - status
                if acknowledged(ready):
                    # Acknowledged by the initialized shell, not socket creation or
                    # a compositor splash frame. Never time out a healthy session.
                    status = child.wait()
                    return status if status >= 0 else 128 - status
                if time.monotonic() >= deadline:
                    print("des-ui: shell startup readiness timed out", file=sys.stderr)
                    stop_group(child)
                    return 124
                time.sleep(0.05)
        except BaseException:
            stop_group(child)
            raise


if __name__ == "__main__":
    if len(sys.argv) < 2:
        sys.exit("usage: des-ui-startup COMMAND [ARG ...]")
    def interrupted(signum, _frame):
        raise SystemExit(128 + signum)
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    sys.exit(run(sys.argv[1:]))
