#!/bin/sh
set -e
theme=/usr/share/plymouth/themes/des-ui/des-ui.plymouth
if [ "$1" = configure ]; then
    update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth "$theme" 200
    # The splash is shown from the boot image, which has to be made again to hold it.
    if command -v update-initramfs >/dev/null; then
        update-initramfs -u || true
    fi
fi
